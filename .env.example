# Vercel supplies OIDC automatically to deployed functions.
# For local development use `vercel env pull .env.local`.
NEXT_PUBLIC_SITE_URL=https://oauthpath-drab.vercel.app
# Keep server secrets in the hosting dashboard, never in source control.
BLOB_READ_WRITE_TOKEN=
AI_GATEWAY_API_KEY=
RESEARCH_MODEL=anthropic/claude-haiku-4.5
